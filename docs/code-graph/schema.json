{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mia.local/schemas/code-graph-1.0.0.json",
  "title": "Mia Code Graph",
  "type": "object",
  "required": ["schema_version", "generated_at", "repository", "commit", "source_digest", "summary", "nodes", "edges", "index_errors", "diagnostics", "limitations"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "generated_at": {"type": "string", "format": "date-time"},
    "repository": {"type": "string"},
    "commit": {"type": "string"},
    "source_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "summary": {"type": "object", "required": ["nodes", "edges", "files", "python_files", "parse_errors"], "properties": {"nodes": {"type": "integer", "minimum": 0}, "edges": {"type": "integer", "minimum": 0}, "files": {"type": "integer", "minimum": 0}, "python_files": {"type": "integer", "minimum": 0}, "parse_errors": {"type": "integer", "minimum": 0}}},
    "nodes": {"type": "array", "items": {"type": "object", "required": ["id", "kind", "key"], "properties": {"id": {"type": "string"}, "kind": {"type": "string"}, "key": {"type": "string"}, "label": {"type": "string"}, "path": {"type": "string"}, "line": {"type": "integer"}}}},
    "edges": {"type": "array", "items": {"type": "object", "required": ["source", "target", "type", "confidence", "evidence"], "properties": {"source": {"type": "string"}, "target": {"type": "string"}, "type": {"type": "string"}, "confidence": {"enum": ["confirmed", "inferred"]}, "evidence": {"type": "string"}, "line": {"type": ["integer", "null"]}}}},
    "index_errors": {"type": "array", "items": {"type": "object", "required": ["path", "error"], "properties": {"path": {"type": "string"}, "error": {"type": "string"}}}},
    "diagnostics": {"type": "object", "required": ["unreferenced_static_candidates", "circular_imports", "note"], "properties": {"unreferenced_static_candidates": {"type": "array"}, "circular_imports": {"type": "array", "items": {"type": "array", "items": {"type": "string"}}}, "note": {"type": "string"}}},
    "limitations": {"type": "array", "items": {"type": "string"}}
  }
}
