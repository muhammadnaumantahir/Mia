# Mia development server. Keep it bound to localhost until authentication is implemented.
MIA_HOST=127.0.0.1
MIA_PORT=8765
MIA_DATA_DIR=./data
MIA_LOG_LEVEL=INFO

# Safe defaults: local/free-first. Paid inference is disabled.
MIA_AI_MODE=free
MIA_ALLOW_PAID=false
MIA_MAX_MONTHLY_SPEND_USD=0
MIA_MAX_REQUEST_SPEND_USD=0

# Autonomous evolution stays disabled until governance, sandboxing and validation gates pass.
MIA_AUTONOMY_ENABLED=false

# Provider keys belong in a secure local credential store, not this file or Git.
