# Mia development server: keep it on localhost until authentication exists.
MIA_HOST=127.0.0.1
MIA_PORT=8765
MIA_DATA_DIR=./data
MIA_LOG_LEVEL=INFO

# Local Ollama is the default inference provider.
MIA_OLLAMA_BASE_URL=http://127.0.0.1:11434
# Enable only after confirming the selected local model supports structured tool calls.
MIA_OLLAMA_ENABLE_TOOL_CALLING=false

# Optional self-hosted FreeLLMAPI sidecar. No hosted/paid catalog is required.
MIA_FREELLMAPI_ENABLED=false
MIA_FREELLMAPI_BASE_URL=http://127.0.0.1:3001/v1
# Set true only after confirming every active upstream route in the local
# FreeLLMAPI chain is a free tier you are permitted to use.
MIA_FREELLMAPI_ROUTE_FREE=false
MIA_FREELLMAPI_ENABLE_TOOL_CALLING=false
# File and knowledge contents stay local unless you explicitly permit remote context.
MIA_ALLOW_REMOTE_FILE_CONTEXT=false

# Cost governance: paid routes are disabled. Even when enabled, unknown model
# prices are rejected. Add a monthly ledger before enabling paid routing.
MIA_ALLOW_PAID=false
MIA_MAX_MONTHLY_SPEND_USD=0
MIA_MAX_REQUEST_SPEND_USD=0

# Owner-managed app allowlist. Copy config/applications.example.json to config/applications.json.
MIA_APPLICATIONS_FILE=config/applications.json

# Optional computer-access roots. Separate multiple paths with semicolons on Windows.
# If unset, Mia can only access its own ./workspace directory.
# Example: MIA_COMPUTER_ROOTS=D:/Projects;D:/Documents

# Autonomous evolution stays disabled until all safety gates are implemented.
MIA_AUTONOMY_ENABLED=false
MIA_EMERGENCY_STOP=false
MIA_MAX_CPU_PERCENT=75
MIA_MAX_RAM_PERCENT=85

# Provider keys go in the OS credential store:
#   mia-credentials set freellmapi
# Never place credentials in this file or Git.
