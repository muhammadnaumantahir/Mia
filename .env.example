# Mia development server: keep it on localhost until authentication exists.
MIA_HOST=127.0.0.1
MIA_PORT=8765
MIA_DATA_DIR=./data
MIA_LOG_LEVEL=INFO

# Local Ollama is the default inference provider.
MIA_OLLAMA_BASE_URL=http://127.0.0.1:11434
# Enable only after confirming the selected local model supports structured tool calls.
MIA_OLLAMA_ENABLE_TOOL_CALLING=false

# Optional direct OpenAI-compatible cloud/self-hosted providers.
# List IDs here; each uses MIA_PROVIDER_<ID>_* and an OS credential-store key.
# Example: MIA_EXTRA_PROVIDERS=cloud-one,cloud-two
MIA_EXTRA_PROVIDERS=
# Example provider (replace the ID and endpoint with a provider you have chosen):
# MIA_PROVIDER_CLOUD_ONE_BASE_URL=https://provider.example/v1
# MIA_PROVIDER_CLOUD_ONE_ROUTE_FREE=false
# MIA_PROVIDER_CLOUD_ONE_DATA_LOCAL=false
# MIA_PROVIDER_CLOUD_ONE_ENABLE_TOOL_CALLING=false
# Save its key with: mia-credentials set cloud-one

# File and knowledge contents stay local unless you explicitly permit remote context.
MIA_ALLOW_REMOTE_FILE_CONTEXT=false

# Cost governance: paid routes are disabled. If enabled, valid per-request, daily
# and monthly caps are all required; unknown prices/costs fail closed.
MIA_ALLOW_PAID=false
MIA_MAX_DAILY_SPEND_USD=0
MIA_MAX_MONTHLY_SPEND_USD=0
MIA_MAX_REQUEST_SPEND_USD=0

# Owner-managed app allowlist. Copy config/applications.example.json to config/applications.json.
MIA_APPLICATIONS_FILE=config/applications.json

# Optional computer-access roots. Separate multiple paths with semicolons on Windows.
# If unset, Mia can only access its own ./workspace directory.
# Example: MIA_COMPUTER_ROOTS=D:/Projects;D:/Documents

# Background task dispatch is disabled by default.
# When enabled, only approved read-only system/process/app inventory tasks run.
# Filesystem, browser, desktop and all preview/mutation tools stay manual.
MIA_AUTONOMY_ENABLED=false
MIA_EMERGENCY_STOP=false
MIA_MAX_CPU_PERCENT=75
MIA_MAX_RAM_PERCENT=85
MIA_AUTONOMY_INTERVAL_SECONDS=30

# Autonomous life cycle (curiosity backlog + activity journal). Off by default:
# nothing runs in the background until this is true AND the owner has not paused it.
# Owner controls (pause, emergency stop, budgets) live in /api/life/*.
MIA_LIFE_ENABLED=false
# Optional advisory reflections through a loopback Ollama model only.
MIA_LIFE_MODEL_REFLECTION_ENABLED=false
MIA_LIFE_MODEL_REFLECTION_TIMEOUT_SECONDS=12
MIA_LIFE_INTERVAL_SECONDS=300

# Keep automatic capture off during normal use and demos. Set true only after you
# explicitly start the 30-day experiment and want daily local evidence capture.
MIA_EXPERIMENT_AUTO_CAPTURE=false

# Provider keys go in the OS credential store:
#   mia-credentials set <provider-id>
# Never place credentials in this file or Git.
